# RoadNode edge configuration
#
# This is the only environment-file template used by RoadNode.
# Install it with:
#   cp config/telemetry.env.example config/telemetry.env
#
# config/telemetry.env is ignored by Git. The values below match the current
# RoadNode production deployment. Replace MQTT_PASSWORD with the one-time
# password returned when this device was created in the Admin UI.

# ---------------------------------------------------------------------------
# DEVICE AND VEHICLE IDENTITY (Admin UI)
# ---------------------------------------------------------------------------
# Admin -> Devices -> open the device -> UUID in the browser URL.
DEVICE_ID=fc8c2be1-efda-4cae-a7e5-5990682f236b
# Admin -> Vehicles -> Vehicle ID. The device must be assigned to this vehicle.
VEHICLE_ID=VEH-001
# Hardware/prototype revision included in device status and telemetry.
PROTOTYPE_STAGE=1

# ---------------------------------------------------------------------------
# GPS RECEIVER (Pi UART)
# ---------------------------------------------------------------------------
GPS_ENABLED=true
GPS_PORT=/dev/serial0
GPS_BAUD=9600

# ---------------------------------------------------------------------------
# MPU6050 IMU (Pi I2C)
# ---------------------------------------------------------------------------
IMU_ENABLED=true
IMU_ADDRESS=0x68
IMU_RATE_HZ=20
# Keep the vehicle and Pi completely still during these calibration samples.
IMU_CALIBRATION_SAMPLES=150
IMU_ORIENTATION=x-forward-y-left-z-up
IMU_CALIBRATION_FILE=~/.local/share/car-telemetry/imu-calibration.json
IMU_CALIBRATION_MAX_AGE_DAYS=90
# Wait for startup vibration to settle, then retry automatically after motion.
IMU_CALIBRATION_SETTLE_SECONDS=2
IMU_CALIBRATION_RETRY_SECONDS=5
HARSH_ACCEL_MPS2=3.0
HARSH_BRAKE_MPS2=-3.0
HARSH_CORNER_MPS2=3.5
IMPACT_G=2.5

# ---------------------------------------------------------------------------
# OPTIONAL OLED STATUS DISPLAY (Pi I2C)
# ---------------------------------------------------------------------------
OLED_ENABLED=true
OLED_DRIVER=sh1106
OLED_I2C_BUS=1
OLED_ADDRESS=0x3C
OLED_WIDTH=128
OLED_HEIGHT=64
OLED_ROTATION=0
OLED_PAGE_SECONDS=3
OLED_CONTRAST=160

# ---------------------------------------------------------------------------
# ELM327 / OBD-II CLIENT (USB OR BLUETOOTH)
# ---------------------------------------------------------------------------
OBD_ENABLED=true
# auto tries USB first and then /dev/rfcomm0 Bluetooth.
OBD_TRANSPORT=auto
OBD_USB_PORT=auto
OBD_BLUETOOTH_PORT=/dev/rfcomm0
# Set in the local RoadNode Setup page after selecting the ELM327 adapter.
OBD_MAC=
OBD_RFCOMM_CHANNEL=1
OBD_BAUD=auto
OBD_PROTOCOL=auto
OBD_FAST=true
OBD_TIMEOUT=0.2
OBD_ASYNC_LOOP_DELAY=0.10
OBD_RECONNECT_SECONDS=4
OBD_ROUND_TRIP_SECONDS=0.08
DTC_SCAN_SECONDS=60
DTC_MAX_EVENTS=100
DTC_CLEAR_REQUIRE_ENGINE_OFF=true
VEHICLE_PROFILE_DIR=~/.local/share/car-telemetry/vehicles

# ---------------------------------------------------------------------------
# LOCAL ENGINE API (only the Pi web process uses this)
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8765

# ---------------------------------------------------------------------------
# LOCAL ROADNODE WEB UI (phone/laptop on the same Wi-Fi)
# ---------------------------------------------------------------------------
# Open http://<pi-hostname>.local:8080 after installation.
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_STATE_REFRESH_SECONDS=0.2
WEB_HEARTBEAT_SECONDS=5
WEB_FALLBACK_POLL_SECONDS=1
BLUETOOTH_SCAN_SECONDS=10

# ---------------------------------------------------------------------------
# ROADNODE CLOUD MQTT CLIENT (EMQX)
# ---------------------------------------------------------------------------
MQTT_ENABLED=true
# Cloudflare must leave mqtt.obd2.ragnogroup.com DNS-only (grey cloud), because
# normal Cloudflare HTTP proxying does not proxy raw MQTT on port 8883.
MQTT_HOST=mqtt.obd2.ragnogroup.com
MQTT_PORT=8883
# Admin -> Devices -> creation result. The matching user/password must exist in
# EMQX authentication. This known device username is already filled in.
MQTT_USERNAME=device-rn-0001
MQTT_PASSWORD=REPLACE_WITH_PASSWORD_SHOWN_ONCE_IN_ADMIN
# EMQX uses TLS plus username/password. Install the public CA with
# ./scripts/install-cloud-mqtt-ca.sh before starting the publisher.
MQTT_TLS=true
MQTT_CA_CERT=/etc/roadnode/mqtt-ca.crt
# The application derives the only publish topic automatically:
# roadnode/v2/devices/{DEVICE_ID}/frame

# ---------------------------------------------------------------------------
# DURABLE CLOUD OUTBOX
# ---------------------------------------------------------------------------
# QoS-1 frames remain in SQLite until EMQX acknowledges them. Keep at most
# 256 MiB or 24 hours and send no more than 50 queued frames per drain batch.
OUTBOX_FILE=~/.local/share/car-telemetry/outbox.sqlite3
OUTBOX_MAX_BYTES=268435456
OUTBOX_MAX_AGE_SECONDS=86400
OUTBOX_BATCH_SIZE=50

# ---------------------------------------------------------------------------
# LOCAL RUNTIME STATE
# ---------------------------------------------------------------------------
STATUS_FILE=~/.local/state/car-telemetry/status.json
