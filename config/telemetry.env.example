# RoadNode edge configuration
#
# Copy this file before editing it:
#   cp config/telemetry.env.example config/telemetry.env
#
# config/telemetry.env is ignored by Git. Never commit a real MQTT password.
# Values labelled REQUIRED must be replaced for each Pi. The remaining values
# are working defaults and normally do not need to change for the first test.

# ---------------------------------------------------------------------------
# DEVICE IDENTITY
# ---------------------------------------------------------------------------
# REQUIRED: Admin UI -> Devices -> open the device. Copy the UUID from the URL
# after /devices/. This must equal the ID used in the v2 MQTT topic and device
# credential file.
DEVICE_ID=REPLACE_WITH_DEVICE_ID_FROM_ADMIN

# REQUIRED: Admin UI -> Vehicles -> copy the Vehicle ID. The device must also
# be fitted to this vehicle in the Admin UI. This is not the device UUID.
VEHICLE_ID=VEH-001

# Prototype/hardware revision reported in local status and telemetry. Default: 1.
PROTOTYPE_STAGE=1

# ---------------------------------------------------------------------------
# GPS
# ---------------------------------------------------------------------------
# Enable the serial GPS reader. Default: true. Set false if GPS is not attached.
GPS_ENABLED=true
# Raspberry Pi UART used by the GPS. Default: /dev/serial0.
GPS_PORT=/dev/serial0
# GPS serial baud rate. Most NMEA modules use the default 9600.
GPS_BAUD=9600

# ---------------------------------------------------------------------------
# MPU6050 IMU
# ---------------------------------------------------------------------------
# Enable acceleration/gyro collection. Default: true.
IMU_ENABLED=true
# I2C address. Default: 0x68; AD0-high modules normally use 0x69.
IMU_ADDRESS=0x68
# Samples per second. Default: 20 Hz.
IMU_RATE_HZ=20
# Stationary samples used when calculating calibration. Default: 150.
IMU_CALIBRATION_SAMPLES=150
# Physical mounting axes. Keep this default when X points forward, Y left,
# and Z upward; change it only if the sensor is mounted differently.
IMU_ORIENTATION=x-forward-y-left-z-up
# Saved IMU calibration data. Default is below the Pi user's home directory.
IMU_CALIBRATION_FILE=~/.local/share/car-telemetry/imu-calibration.json
# Recalibrate after this many days. Default: 90.
IMU_CALIBRATION_MAX_AGE_DAYS=90
# Event thresholds. Acceleration values are m/s^2 and impact is in g.
HARSH_ACCEL_MPS2=3.0
HARSH_BRAKE_MPS2=-3.0
HARSH_CORNER_MPS2=3.5
IMPACT_G=2.5

# ---------------------------------------------------------------------------
# SMALL OLED (optional local status display)
# ---------------------------------------------------------------------------
# Enable the OLED. Default: true. Set false when no OLED is connected.
OLED_ENABLED=true
# Controller model: sh1106 or ssd1306. Default: sh1106.
OLED_DRIVER=sh1106
# Raspberry Pi I2C bus and display address. Defaults: bus 1, address 0x3C.
OLED_I2C_BUS=1
OLED_ADDRESS=0x3C
# Display dimensions in pixels. Defaults: 128x64.
OLED_WIDTH=128
OLED_HEIGHT=64
# Display rotation in degrees and automatic page interval in seconds.
OLED_ROTATION=0
OLED_PAGE_SECONDS=3
# Brightness/contrast from 0 to 255. Default: 160.
OLED_CONTRAST=160

# ---------------------------------------------------------------------------
# OBD / ELM327
# ---------------------------------------------------------------------------
# Enable OBD collection. Default: true.
OBD_ENABLED=true
# auto tries USB first, then Bluetooth /dev/rfcomm0. Other choices are usb and
# bluetooth. Default: auto.
OBD_TRANSPORT=auto
# USB serial device. auto detects /dev/serial/by-id, ttyUSB, or ttyACM.
OBD_USB_PORT=auto
# Linux RFCOMM device created for a Bluetooth ELM327. Default: /dev/rfcomm0.
OBD_BLUETOOTH_PORT=/dev/rfcomm0
# Bluetooth ELM327 MAC address, for example AA:BB:CC:DD:EE:FF. Leave blank
# until it is selected in the RoadNode Pi web UI or discovered with bluetoothctl.
OBD_MAC=
# ELM327 RFCOMM channel. Default: 1.
OBD_RFCOMM_CHANNEL=1
# Adapter baud and vehicle protocol. auto is recommended for both.
OBD_BAUD=auto
OBD_PROTOCOL=auto
# Enable python-OBD fast mode. Default: true.
OBD_FAST=true
# Query timeout, async loop delay, and reconnect delay in seconds.
OBD_TIMEOUT=0.2
OBD_ASYNC_LOOP_DELAY=0.10
OBD_RECONNECT_SECONDS=4
# Estimated seconds per PID query. It limits optional PIDs so core readings do
# not become stale. Default: 0.08.
OBD_ROUND_TRIP_SECONDS=0.08

# Scan stored diagnostic trouble codes every 60 seconds and keep at most 100
# events. Clearing DTCs requires the engine to be off by default.
DTC_SCAN_SECONDS=60
DTC_MAX_EVENTS=100
DTC_CLEAR_REQUIRE_ENGINE_OFF=true

# Per-vehicle preferences and supported-PID cache. VIN is used when available.
VEHICLE_PROFILE_DIR=~/.local/share/car-telemetry/vehicles

# ---------------------------------------------------------------------------
# INTERNAL ENGINE API (Pi localhost only)
# ---------------------------------------------------------------------------
# Used by the RoadNode web process to talk to the collection engine. Keep the
# default loopback address unless the architecture is deliberately changed.
API_HOST=127.0.0.1
API_PORT=8765

# ---------------------------------------------------------------------------
# ROADNODE PI WEB UI (local network only)
# ---------------------------------------------------------------------------
# Open http://<pi-hostname>.local:8080 on a phone/laptop on the same network.
WEB_ENABLED=true
# 0.0.0.0 makes the UI reachable from the Pi's LAN interfaces.
WEB_HOST=0.0.0.0
WEB_PORT=8080
# UI state refresh, WebSocket heartbeat, and fallback polling intervals.
WEB_STATE_REFRESH_SECONDS=0.2
WEB_HEARTBEAT_SECONDS=5
WEB_FALLBACK_POLL_SECONDS=1
# Bluetooth discovery duration in seconds. Default: 10.
BLUETOOTH_SCAN_SECONDS=10

# ---------------------------------------------------------------------------
# ROADNODE CLOUD MQTT
# ---------------------------------------------------------------------------
# Cloud publishing is enabled in this production-ready example. The code's
# safe fallback when MQTT_ENABLED is omitted is false.
MQTT_ENABLED=true
# Production broker and TLS listener. These defaults are already correct for
# the RoadNode deployment; mqtt.obd2.ragnogroup.com must be DNS-only in Cloudflare.
MQTT_HOST=mqtt.obd2.ragnogroup.com
MQTT_PORT=8883
# Unique connection name. Replace the suffix with the same Admin device UUID.
# If this variable is omitted, the code defaults to roadnode-pi-{DEVICE_ID}.
MQTT_CLIENT_ID=roadnode-pi-REPLACE_WITH_DEVICE_ID_FROM_ADMIN

# Legacy v1 topics. They default to roadnode/v1/vehicles/{VEHICLE_ID}/... .
# The durable production publisher does not use these: it always publishes to
# roadnode/v2/devices/{DEVICE_ID}/frame.
MQTT_TOPIC=roadnode/v1/vehicles/VEH-001/telemetry
MQTT_DTC_TOPIC=roadnode/v1/vehicles/VEH-001/dtc
MQTT_METADATA_TOPIC=roadnode/v1/vehicles/VEH-001/metadata
MQTT_STATUS_TOPIC=roadnode/v1/vehicles/VEH-001/status

# REQUIRED: credentials shown once when the device is provisioned in Admin.
# Create the identical user/password in EMQX. Both the legacy MQTT client and
# durable v2 publisher read these values from this one protected env file.
MQTT_USERNAME=REPLACE_WITH_MQTT_USERNAME_FROM_ADMIN
MQTT_PASSWORD=REPLACE_WITH_MQTT_PASSWORD_FROM_ADMIN

# Use TLS and trust the private RoadNode MQTT CA installed by:
#   ./scripts/install-cloud-mqtt-ca.sh
MQTT_TLS=true
MQTT_CA_CERT=/etc/roadnode/mqtt-ca.crt
# Leave these blank because the current deployment authenticates with a broker
# username/password rather than a per-device client certificate.
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
# Publish interval and short in-memory buffer duration in seconds.
MQTT_PUBLISH_SECONDS=3
MQTT_BUFFER_SECONDS=60

# ---------------------------------------------------------------------------
# DURABLE V2 CREDENTIAL FALLBACK AND OUTBOX
# ---------------------------------------------------------------------------
# Optional backward-compatible credential JSON used only when MQTT_USERNAME
# and MQTT_PASSWORD above are both blank. New installations do not need to
# create this file; keep the default path for existing provisioned devices.
DEVICE_CREDENTIAL_FILE=~/.local/share/car-telemetry/device-credential.json

# Unacknowledged QoS-1 frames persist in SQLite and are removed after PUBACK.
OUTBOX_FILE=~/.local/share/car-telemetry/outbox.sqlite3
# Retain at most 256 MiB or 24 hours, whichever limit is reached first.
OUTBOX_MAX_BYTES=268435456
OUTBOX_MAX_AGE_SECONDS=86400
# Maximum queued frames attempted in one publishing batch. Default: 50.
OUTBOX_BATCH_SIZE=50

# ---------------------------------------------------------------------------
# RUNTIME STATE
# ---------------------------------------------------------------------------
# Latest local engine state consumed by the CLI and Pi web UI.
STATUS_FILE=~/.local/state/car-telemetry/status.json
