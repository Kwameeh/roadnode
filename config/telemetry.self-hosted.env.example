# RoadNode production cloud values
#
# Use config/telemetry.env.example as the complete file. This smaller example
# lists every value involved in cloud identity and publishing. The broker, port,
# TLS, CA path, publishing cadence, and storage limits already contain their
# production defaults. Replace only values labelled REQUIRED.
# Never commit config/telemetry.env or a real device secret.

# REQUIRED: UUID from Admin UI -> Devices -> open the device -> copy the value
# after /devices/ in the browser URL.
DEVICE_ID=REPLACE_WITH_DEVICE_ID_FROM_ADMIN

# REQUIRED: ID from Admin UI -> Vehicles. Also fit the device to this vehicle
# in the Admin UI. This default is correct only if the created ID is VEH-001.
VEHICLE_ID=VEH-001

# The code defaults to roadnode-pi-{DEVICE_ID}; it is written explicitly here
# so it is easy to verify in EMQX -> Monitoring -> Clients.
MQTT_CLIENT_ID=roadnode-pi-REPLACE_WITH_DEVICE_ID_FROM_ADMIN

# Production broker settings. Leave these defaults unchanged.
MQTT_ENABLED=true
MQTT_LEGACY_ENABLED=false
MQTT_HOST=mqtt.obd2.ragnogroup.com
MQTT_PORT=8883
MQTT_TLS=true

# Install this public CA with ./scripts/install-cloud-mqtt-ca.sh. The empty
# client certificate/key values are intentional: EMQX uses username/password.
MQTT_CA_CERT=/etc/roadnode/mqtt-ca.crt
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=

# REQUIRED: username and one-time password returned by Admin device
# provisioning. Create the same user in EMQX before starting the Pi.
MQTT_USERNAME=REPLACE_WITH_MQTT_USERNAME_FROM_ADMIN
MQTT_PASSWORD=REPLACE_WITH_MQTT_PASSWORD_FROM_ADMIN

# Legacy v1 topic defaults. The production worker consumes the durable v2 topic
# roadnode/v2/devices/{DEVICE_ID}/frame, which is derived automatically.
MQTT_TOPIC=roadnode/v1/vehicles/VEH-001/telemetry
MQTT_DTC_TOPIC=roadnode/v1/vehicles/VEH-001/dtc
MQTT_METADATA_TOPIC=roadnode/v1/vehicles/VEH-001/metadata
MQTT_STATUS_TOPIC=roadnode/v1/vehicles/VEH-001/status

# Optional legacy fallback. New installations use MQTT_USERNAME and
# MQTT_PASSWORD from telemetry.env and do not need to create this JSON file.
DEVICE_CREDENTIAL_FILE=~/.local/share/car-telemetry/device-credential.json

# Production cadence and short in-memory buffering defaults.
MQTT_PUBLISH_SECONDS=3
MQTT_BUFFER_SECONDS=60

# QoS-1 SQLite outbox defaults: 256 MiB, 24 hours, 50 frames per batch.
OUTBOX_FILE=~/.local/share/car-telemetry/outbox.sqlite3
OUTBOX_MAX_BYTES=268435456
OUTBOX_MAX_AGE_SECONDS=86400
OUTBOX_BATCH_SIZE=50

# Latest local runtime state read by the CLI and Pi web UI.
STATUS_FILE=~/.local/state/car-telemetry/status.json
