# Self-hosted MQTT override for the currently implemented v1 RoadNode publisher.
# Copy the main telemetry.env.example first, then replace its identity/MQTT
# section with these values. Never commit config/telemetry.env.

DEVICE_ID=PROTO-001
VEHICLE_ID=VEH-001

MQTT_ENABLED=true
MQTT_HOST=mqtt.example.com
MQTT_PORT=8883
MQTT_CLIENT_ID=roadnode-pi-PROTO-001
MQTT_USERNAME=PROTO-001
MQTT_PASSWORD=REPLACE_WITH_UNIQUE_DEVICE_PASSWORD
MQTT_TLS=true
MQTT_CA_CERT=/etc/roadnode/mqtt-ca.crt
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=

# The present Python implementation publishes schema v1 every three seconds.
# Give this username permission only to these four exact topics in EMQX.
MQTT_TOPIC=roadnode/v1/vehicles/VEH-001/telemetry
MQTT_DTC_TOPIC=roadnode/v1/vehicles/VEH-001/dtc
MQTT_METADATA_TOPIC=roadnode/v1/vehicles/VEH-001/metadata
MQTT_STATUS_TOPIC=roadnode/v1/vehicles/VEH-001/status
MQTT_PUBLISH_SECONDS=3
MQTT_BUFFER_SECONDS=60
