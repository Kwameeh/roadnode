# Production RoadNode cloud override. Copy telemetry.env.example to
# telemetry.env, then replace its identity/MQTT section with these values.
# Never commit config/telemetry.env or a real device password.

DEVICE_ID=REPLACE_WITH_DEVICE_ID_FROM_ADMIN
VEHICLE_ID=VEH-001

MQTT_ENABLED=true
MQTT_HOST=mqtt.obd2.ragnogroup.com
MQTT_PORT=8883
MQTT_CLIENT_ID=roadnode-pi-REPLACE_WITH_DEVICE_ID_FROM_ADMIN
MQTT_USERNAME=REPLACE_WITH_MQTT_USERNAME_FROM_ADMIN
MQTT_PASSWORD=REPLACE_WITH_MQTT_PASSWORD_FROM_ADMIN
MQTT_TLS=true
MQTT_CA_CERT=/etc/roadnode/mqtt-ca.crt
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=

# The durable v2 publisher derives its exact topic from DEVICE_ID:
# roadnode/v2/devices/{DEVICE_ID}/frame. The credential file is written by
# scripts/provision-device.py and is authoritative for that publisher.
DEVICE_CREDENTIAL_FILE=~/.local/share/car-telemetry/device-credential.json
MQTT_PUBLISH_SECONDS=3
MQTT_BUFFER_SECONDS=60
